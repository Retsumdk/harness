{
  "name": "harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:web": "vite build",
    "start": "bun run src/server/main.ts",
    "dev": "vite",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "typecheck": "bunx tsc --noEmit",
    "smoke": "bun run scripts/smoke.ts",
    "build:demo": "vite build --config vite.demo.config.ts && bash scripts/finalize-demo.sh",
    "cli": "bun run src/cli/main.ts",
    "perf": "bun run scripts/perf-check.ts",
    "check": "bunx tsc --noEmit && bun test && bun run build:web && bun run build:demo && bun run smoke && bun run perf"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "hono": "^4.13.18",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
