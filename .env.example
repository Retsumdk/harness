# HARNESS environment. Copy to .env and fill in what you need.
# The server reads .env automatically when started with `bun run start`.
#
# Every value below has a working default except HARNESS_TOKEN, which the server
# refuses to boot without: this app writes files and runs commands, so it will
# not start unauthenticated.

# --- required -------------------------------------------------------------
# The single access token. The web client asks for it once and keeps it in the
# browser; the CLI reads it from this variable. Use a long random string:
#   bun -e 'console.log(crypto.randomUUID() + crypto.randomUUID())'
HARNESS_TOKEN=change-me-to-a-long-random-string

# --- server ---------------------------------------------------------------
# HTTP port.
HARNESS_PORT=8787

# Where the database and the workspace live. Created on first boot.
HARNESS_HOME=.harness

# The built web client. `bun run build:web` writes here.
HARNESS_WEB_DIST=dist/web

# --- model providers ------------------------------------------------------
# The `mock` provider is always available and needs no key. To add a real
# OpenAI-compatible endpoint, set the three values below and it appears in the
# provider list as `openai-compat`.
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# --- CLI (not read by the server) -----------------------------------------
# Where `harness` should connect. Defaults to http://localhost:8787.
# HARNESS_URL=http://localhost:8787
